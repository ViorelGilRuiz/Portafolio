{
  "name": "viorel-gil-portfolio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "lint": "eslint script.js scripts tests && html-validate index.html",
    "typecheck": "tsc --allowJs --checkJs --noEmit --target es2022 --module nodenext --moduleResolution nodenext --lib es2022,dom,dom.iterable script.js",
