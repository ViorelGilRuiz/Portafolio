    "test:browser": "node tests/browser.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@eslint/js": "9.39.1",
    "@types/node": "24.10.1",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "html-validate": "10.4.0",
    "lighthouse": "^13.0.1",
    "pdfjs-dist": "5.4.394",
    "playwright": "1.56.1",
    "prettier": "^3.7.3",
    "sharp": "0.34.5",
    "typescript": "5.9.3"
  }
}
